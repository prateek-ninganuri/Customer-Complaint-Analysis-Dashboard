              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1554737527181317]&#13;&#10;&#13;&#10;WHEN &quot;BANK SERVICES&quot; THEN&#13;&#10;    [Product (group)] = &quot;BANK SERVICES&quot;&#13;&#10;&#13;&#10;WHEN &quot;CHECKING/SERVICES&quot; THEN&#13;&#10;    [Product (group)] = &quot;CHECKING/SERVICES&quot;&#13;&#10;&#13;&#10;WHEN &quot;CREDIT CARD&quot; THEN&#13;&#10;    [Product (group)] = &quot;CREDIT CARD&quot;&#13;&#10;&#13;&#10;WHEN &quot;MORTGAGE&quot; THEN&#13;&#10;    [Product (group)] = &quot;MORTGAGE&quot;&#13;&#10;&#13;&#10;WHEN &quot;OTHERS&quot; THEN&#13;&#10;    [Product (group)] = &quot;OTHERS&quot;&#13;&#10;&#13;&#10;WHEN &quot;ALL&quot; THEN&#13;&#10;    [Product (group)] IN (&#13;&#10;        &quot;BANK SERVICES&quot;,&#13;&#10;        &quot;CHECKING/SERVICES&quot;,&#13;&#10;        &quot;CREDIT CARD&quot;,&#13;&#10;        &quot;MORTGAGE&quot;,&#13;&#10;        &quot;OTHER&quot;&#13;&#10;    )&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date Received]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Number of Complaints]' role='measure' type='quantitative' />
